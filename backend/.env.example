# AQSS backend — environment variables (copy to .env for local runs).
#
# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres (docker-compose or the system service).
# Neon: DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/aqss_db
DB_USER=aqss_user
DB_PASS=aqss_password
# DB_POOL_MAX=5
# DB_POOL_MIN=2

# ─── MQTT ────────────────────────────────────────────────────────────────────
# Local broker:   tcp://localhost:1883
# HiveMQ Cloud:   ssl://<cluster>.s1.eu.hivemq.cloud:8883
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=aqss-backend
MQTT_USER=aqss_device
MQTT_PASS=aqss_password
MQTT_QOS=1

# ─── Layer 3 (FastAPI) ───────────────────────────────────────────────────────
AI_BASE_URL=http://localhost:8000
AI_ENABLED=false
# AI_TIMEOUT_MS=30000

# ─── Control loop ────────────────────────────────────────────────────────────
# CONTROL_CYCLE_MS=60000
# CONTROL_HYSTERESIS_RATIO=0.7
# CONTROL_MIN_ON_MINUTES=5

# ─── Dashboard ───────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Server ──────────────────────────────────────────────────────────────────
# SERVER_PORT=8080   (the platform-injected PORT is used when SERVER_PORT is unset)
# LOG_LEVEL_AQSS=INFO
