# ─────────────────────────────────────────────────────────────────────────────
# AQSS backend — environment inventory
#
#   docker compose: copy this file to .env (`cp .env.example .env`). Compose reads .env for
#   its own ${...} interpolation AND injects it into the backend container, so this single
#   file configures the whole stack — application.yml never needs editing.
#
#   bare jar / systemd: export these variables in the unit (EnvironmentFile=/etc/aqss/env),
#   or point DB_URL/JWT_SECRET at your secret store.
#
#   Blank values are NOT the same as absent: `JWT_SECRET=` (empty) reaches the app as an empty
#   secret and fails at startup, whereas leaving the line commented-out falls back to the
#   default in application.yml. Comment out anything you do not mean to set.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ CHANGE THESE BEFORE A REAL DEPLOYMENT ═══════════════════════════════════
#   POSTGRES_PASSWORD  - database password ("openssl rand -base64 24")
#   JWT_SECRET         - token signing key, >= 32 bytes ("openssl rand -base64 48")
#   MQTT_PASS          - broker password, must match the mosquitto password file
#   CORS_ORIGIN        - the real dashboard origin, not localhost
#   ADMIN_PASSWORD     - the seeded admin's password (see below), or disable the seeder
# ═════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# POSTGRES_* are read by the postgres service to create the database+role, and POSTGRES_PORT
# only publishes the container port on the host (useful when 5432 is taken or you do not want
# to expose the database at all — drop the ports mapping for that).
POSTGRES_USER=aqss_user
POSTGRES_PASSWORD=aqss_password
POSTGRES_DB=aqss_db
POSTGRES_PORT=5432

# DB_* are read by the application. Under docker compose the backend service maps
# POSTGRES_* onto these automatically, so you only need them for a bare-jar deployment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aqss_db
DB_USER=aqss_user
DB_PASS=aqss_password

# Leave DB_URL unset to build the JDBC URL from the parts above (it already enables
# reWriteBatchedInserts). Set it to override the whole thing — TLS params, a managed
# Postgres, a pooling proxy, e.g.
#   DB_URL=jdbc:postgresql://db.internal:5432/aqss_db?sslmode=require&reWriteBatchedInserts=true
# DB_URL=

# ─── MQTT broker ─────────────────────────────────────────────────────────────
# MQTT_ENABLED=false runs the backend with no broker at all (REST + control loop still work).
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
# Must be unique per running backend instance, or two instances fight over one MQTT session.
MQTT_CLIENT_ID=aqss-backend-server
MQTT_USER=aqss_device
MQTT_PASS=aqss_password
MQTT_QOS=1
# MQTT_BROKER_URL=tcp://broker.example.com:1883

# ─── HTTP server / security ──────────────────────────────────────────────────
SERVER_PORT=8080
# HS256 signing key, >= 32 bytes / 256 bits.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# The dashboard origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# ─── Layer 3 AI service (Phases 8–9) ─────────────────────────────────────────
# enabled=false keeps the rule-based threshold/dosage stand-ins in use.
AI_ENABLED=false
AI_HOST=localhost
AI_PORT=8000
# AI_BASE_URL=http://layer3-ai:8000

# ─── Seeded admin account ────────────────────────────────────────────────────
# Created once, only when the users table is empty. Leave ADMIN_EMAIL empty to disable seeding
# entirely and register the first account through POST /api/v1/auth/register.
ADMIN_EMAIL=admin@aqss.local
ADMIN_PASSWORD=admin12345

# ─── Tuning knobs — uncomment to override the application.yml defaults ───────
# Duration/level hints are milliseconds, minutes, µg/m³ or ratio as named.
# DB_POOL_MAX=20
# DB_POOL_MIN=10
# DB_POOL_CONNECTION_TIMEOUT_MS=30000
# DB_BATCH_SIZE=100
# FLYWAY_ENABLED=true
# FLYWAY_BASELINE_ON_MIGRATE=true
# MANAGEMENT_ENDPOINTS=health,info
# JWT_ACCESS_TTL_MS=1800000
# JWT_REFRESH_TTL_MS=604800000
# AI_TIMEOUT_MS=30000

# Control loop (docs/backend-layer.md §4 safety constraints)
# CONTROL_CYCLE_MS=60000
# CONTROL_HYSTERESIS_RATIO=0.7
# CONTROL_MIN_ON_MINUTES=5
# CONTROL_MIN_OFF_MINUTES=3
# CONTROL_MAX_ON_MINUTES=120
# CONTROL_FAILSAFE_MINUTES=10
# CONTROL_FILTER_CADR=40.0
# CONTROL_PENETRATION_FACTOR=0.8
# CONTROL_OUTDOOR_PM25=35.0
# CONTROL_FORECAST_CRON=0 0 * * * *

# Telemetry ingestion
# TELEMETRY_FLUSH_MS=1000
# TELEMETRY_QUEUE_CAPACITY=10000
# TELEMETRY_ROLLING_WINDOW_MINUTES=5

# Partition + materialized-view lifecycle (turn the crons off on a non-leader replica)
# PARTITION_CREATE_CRON=0 0 3 25 * *
# PARTITION_DROP_CRON=0 0 2 1 * *
# PARTITION_HOURLY_VIEW_CRON=0 */15 * * * *
# PARTITION_DAILY_VIEW_CRON=0 5 * * * *
# PARTITION_RETENTION_DAYS=90

# Topic namespaces — must match the firmware contract, change both sides together
# MQTT_TOPIC_TELEMETRY=aqss/devices/+/telemetry
# MQTT_TOPIC_STATUS=aqss/devices/+/status
# MQTT_TOPIC_ACTUATOR_STATE=aqss/devices/+/actuator/state

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL_AQSS=INFO
# LOG_LEVEL_MQTT=WARN
